pipeline {
    agent any

    environment {
        REGISTRY = "docker.io"                  // DockerHub registry
        FRONTEND_IMAGE = "ghansyamaws/usercreds-image"  // frontend repo
        BACKEND_IMAGE = "ghansyamaws/server-image"    // backend repo
        PASSWORD = credentials('Docker@hub2025;') // Jenkins credential ID
    }

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/githubWithGHANA/cicd-docker-swarm-pipeline.git'
            }
        }

        stage('Build Frontend') {
            steps {
                sh 'docker build -t $FRONTEND_IMAGE:latest -f Dockerfile .'
            }
        }

        stage('Build Backend') {
            steps {
                sh 'docker build -t $BACKEND_IMAGE:latest -f backend/Dockerfile ./backend'
            }
        }

        stage('Push Images') {
            steps {
                sh 'echo $PASSWORD | docker login -u reyadocker --password-stdin'
                sh 'docker push $FRONTEND_IMAGE:latest'
                sh 'docker push $BACKEND_IMAGE:latest'
            }
        }

        stage('Deploy to Swarm') {
            steps {
                sh 'docker stack deploy -c docker-compose.yml userdata-deploy'
            }
        }
    }
}
